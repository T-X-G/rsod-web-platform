# 环境配置模板 — 复制为 .env 后填写

# DeepSeek AI 问答
DEEPSEEK_API_KEY=sk-9cc81da15ef84d278456d9008098ff8c
DEEPSEEK_API_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# JWT 认证密钥
JWT_SECRET_KEY=change-me-to-a-random-string

# 中文字体路径 (Windows: C:/Windows/Fonts/simhei.ttf, Linux: /usr/share/fonts/simhei.ttf)
FONT_PATH=C:/Windows/Fonts/simhei.ttf

# 数据库配置
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=rsod_user
DB_PASSWORD=rsod_password
DB_DATABASE=rsod_db

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_password

# MinIO 配置
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# 调试模式
DEBUG=true
